.my-header {
  padding: 16rpx 4rpx 28rpx;
}

.my-title {
  color: #0f172a;
  font-size: 44rpx;
  font-weight: 800;
}

.enrollment-card {
  border-left: 8rpx solid #047857;
}

.enrollment-title {
  flex: 1;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
  word-break: break-all;
}

.enrollment-meta {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}

.meta-line {
  display: flex;
  gap: 16rpx;
  margin-bottom: 10rpx;
  color: #1e293b;
  font-size: 26rpx;
  word-break: break-all;
}

.meta-line:last-child {
  margin-bottom: 0;
}

.meta-label {
  flex: 0 0 110rpx;
  color: #475569;
  font-weight: 600;
}

.pay-btn {
  margin-top: 22rpx;
}

.retry-btn {
  margin-top: 24rpx;
}

.empty-title {
  margin: 16rpx 0 8rpx;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-action {
  margin-top: 28rpx;
}
