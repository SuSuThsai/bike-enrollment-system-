<view class="page">
  <view class="hero">
    <view class="hero-kicker">RIDE TOGETHER</view>
    <view class="hero-title">找到下一场值得出发的骑行</view>
    <view class="hero-subtitle">浏览赛事与组别，查看实时名额。报名与支付请在小程序内完成。</view>
  </view>

  <scroll-view scroll-x class="filters" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{filters}}"
      wx:key="value"
      class="filter-chip {{status === item.value ? 'active' : ''}}"
      data-status="{{item.value}}"
      bindtap="selectFilter"
    >{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="list">
    <view wx:for="{{skeletons}}" wx:key="*this" class="skeleton" />
  </view>

  <view wx:elif="{{error}}" class="error-box">
    <view>{{error}}</view>
    <button class="secondary-btn retry-btn" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{events.length === 0}}" class="empty">
    <view class="empty-icon">🚴</view>
    <view class="empty-title">暂无赛事</view>
    <view class="tiny">换个筛选条件看看，或稍后再来。</view>
  </view>

  <view wx:else class="list">
    <view
      wx:for="{{events}}"
      wx:key="id"
      class="event-card card"
      hover-class="card-hover"
      data-id="{{item.id}}"
      bindtap="openEvent"
    >
      <view class="event-head">
        <view class="event-title">{{item.title}}</view>
        <view class="status-pill status-{{item.statusTone}}">{{item.statusText}}</view>
      </view>
      <view class="event-meta">
        <view class="meta-row"><text class="meta-label">时间</text><text>{{item.dateText}}</text></view>
        <view class="meta-row {{item.deadlineSoon ? 'deadline-soon' : ''}}">
          <text class="meta-label">报名截止</text>
          <text>{{item.deadlineText}}</text>
          <text wx:if="{{item.deadlineSoon}}" class="deadline-tag">即将截止</text>
        </view>
        <view class="meta-row"><text class="meta-label">持续</text><text>{{item.durationText}}</text></view>
        <view class="meta-row"><text class="meta-label">地点</text><text>{{item.location}}</text></view>
      </view>
      <view class="event-footer">
        <view>
          <view class="tiny">最低报名费</view>
          <view class="price">{{item.priceText}}</view>
        </view>
        <view class="detail-link">查看详情 ›</view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="loading">正在加载更多…</view>
    <view wx:elif="{{!hasMore && events.length > 0}}" class="list-end">已经到底了</view>
  </view>
</view>
