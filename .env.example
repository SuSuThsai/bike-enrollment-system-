# ===== 数据库 =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 本地开发自行设置，需与 docker-compose.yml 的 MYSQL_USER 保持一致
MYSQL_USER=
# 本地开发自行设置；生产环境务必使用强随机串
MYSQL_PASSWORD=
MYSQL_DATABASE=bike_enroll
# 仅 docker compose 启动 MySQL 容器时使用；请自行设置强随机串
MYSQL_ROOT_PASSWORD=

# ===== Redis =====
REDIS_ADDR=127.0.0.1:6379
# 无密码留空
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT =====
# 生成方式：openssl rand -hex 32（至少 32 字节；不得使用曾公开的默认值）
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# ===== 微信小程序 =====
# 来源：mp.weixin.qq.com → 开发 → 开发设置
WECHAT_APPID=
# 同上，仅后端使用，切勿提交到仓库
WECHAT_SECRET=

# ===== 微信支付（Mock 模式可留空）=====
# mock | wechat
PAYMENT_MODE=mock
# Mock 模式下内部触发接口的密钥，自行设置随机串
MOCK_PAY_SECRET=
# 来源：pay.weixin.qq.com → 账户中心 → 商户信息
WECHAT_PAY_MCHID=
# 来源：商户平台 → API安全 → API证书
WECHAT_PAY_SERIAL_NO=
# 来源：商户平台 → API安全 → APIv3密钥（32 字节）
WECHAT_PAY_APIV3_KEY=
# 证书/私钥由使用者自行放入 server/configs/，见该目录 README.md
WECHAT_PAY_PRIVATE_KEY_PATH=./configs/apiclient_key.pem
# 你的公网 HTTPS 回调地址
WECHAT_PAY_NOTIFY_URL=

# ===== 业务参数 =====
LOCK_TTL_MINUTES=15
PAY_TIMEOUT_MINUTES=15

# ===== 服务 / 容器（docker compose 读取，按需修改）=====
# development | production；production 下 PAYMENT_MODE=mock 会被拒绝启动
APP_ENV=development
# 宿主机映射端口
API_PORT=8080
LOG_LEVEL=info
TZ=Asia/Shanghai
# 构建阶段 Go 模块代理
GOPROXY=https://goproxy.io,direct
# 压测用：>0 时优先于 LOCK_TTL_MINUTES，生产留空
LOCK_TTL_SECONDS=
